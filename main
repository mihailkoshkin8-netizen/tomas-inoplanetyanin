if genv.__SpeedGuiHandle then
    pcall(function()
        if genv.__SpeedGuiHandle.unload then genv.__SpeedGuiHandle.unload() end
    end)
    genv.__SpeedGuiHandle = nil
end
for _, g in ipairs(playerGui:GetChildren()) do
    if g.Name == "SpeedGui" then pcall(function() g:Destroy() end) end
end

