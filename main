-- === ПЕРЕТАСКИВАНИЕ (hit-test) ===
local function pointHitsChildButton(frame, pos)
    for _, d in ipairs(frame:GetDescendants()) do
        if d:IsA("GuiButton") and d.Visible and d.Active then
            local ap = d.AbsolutePosition
            local as = d.AbsoluteSize
            if pos.X >= ap.X and pos.X < ap.X + as.X
                and pos.Y >= ap.Y and pos.Y < ap.Y + as.Y then
                return true
            end
        end
    end
    return false
end

local function makeDraggable(frame)
    local dragging, dragStart, startPos
    local moved = false

    frame.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        if pointHitsChildButton(frame, input.Position) then return end

        dragging = true
        moved = false
        dragStart = input.Position
        startPos = frame.Position
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            if delta.Magnitude > 3 then moved = true end
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    return function() return moved end
end

local mainWasMoved = makeDraggable(main)
local miniWasMoved = makeDraggable(miniBtn)

-- === ВИЗУАЛ ===
local function setSpeedVisual(on)
    if on then
        toggleBtn.Text = "ON"
        toggleBtn.TextColor3 = Color3.fromRGB(120, 220, 160)
        toggleBtn.BackgroundColor3 = Color3.fromRGB(22, 40, 30)
        toggleStroke.Color = Color3.fromRGB(60, 140, 95)
    else
        toggleBtn.Text = "OFF"
        toggleBtn.TextColor3 = Color3.fromRGB(200, 200, 210)
        toggleBtn.BackgroundColor3 = Color3.fromRGB(26, 26, 30)
        toggleStroke.Color = Color3.fromRGB(44, 44, 50)
    end
end

local function setBypassVisual(on)
    if on then
        bypassBtn.Text = "BYPASS AC · ON"
        bypassBtn.TextColor3 = Color3.fromRGB(240, 180, 110)
        bypassBtn.BackgroundColor3 = Color3.fromRGB(44, 34, 18)
        bypassStroke.Color = Color3.fromRGB(160, 110, 50)
    else
        bypassBtn.Text = "BYPASS AC"
        bypassBtn.TextColor3 = Color3.fromRGB(200, 200, 210)
        bypassBtn.BackgroundColor3 = Color3.fromRGB(26, 26, 30)
        bypassStroke.Color = Color3.fromRGB(44, 44, 50)
    end
end

-- === BYPASS ===
local function activateBypass()
    local char = lp.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    savedState = {}
    savedState.hum = hum

    local animate = char:FindFirstChild("Animate")
    if animate then
        savedState.animate = animate
        savedState.animateDisabled = animate.Disabled
        pcall(function() animate.Disabled = true end)
    end

    local animator = hum:FindFirstChildOfClass("Animator")
    if animator then
        savedState.animator = animator
        for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
            pcall(function() t:Stop(0) end)
        end
        savedState.trackConn = animator.AnimationPlayed:Connect(function(track)
            pcall(function() track:Stop(0) end)
            pcall(function() task.defer(function() track:Destroy() end) end)
        end)
    end

    savedState.hiddenAnimations = {}
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("Animation") then
            table.insert(savedState.hiddenAnimations, {obj = obj, parent = obj.Parent})
            obj.Parent = nil
        end
    end
end

local function deactivateBypass()
    if savedState.trackConn then
        pcall(function() savedState.trackConn:Disconnect() end)
    end
    if savedState.animate and savedState.animate.Parent then
        pcall(function() savedState.animate.Disabled = savedState.animateDisabled or false end)
    end
    for _, entry in ipairs(savedState.hiddenAnimations or {}) do
        pcall(function()
            if entry.parent and entry.parent.Parent then
                entry.obj.Parent = entry.parent
            end
        end)
    end
    savedState = {}
end

-- === ОБЩЕЕ ОТКЛЮЧЕНИЕ ===
local function disableAll()
    if enabled then
        enabled = false
        setSpeedVisual(false)
    end
    if bypassActive then
        bypassActive = false
        pcall(deactivateBypass)
        setBypassVisual(false)
    end
end

-- === ОБРАБОТЧИКИ ===
toggleBtn.MouseButton1Click:Connect(function()
    enabled = not enabled
    setSpeedVisual(enabled)
end)

bypassBtn.MouseButton1Click:Connect(function()
    bypassActive = not bypassActive
    if bypassActive then
        activateBypass()
    else
        deactivateBypass()
    end
    setBypassVisual(bypassActive)
end)

inputBox:GetPropertyChangedSignal("Text"):Connect(function()
    local v = tonumber(inputBox.Text)
    if v and v > 0 and v <= BONUS_CAP then
        targetSpeed = v
    end
end)

-- === MINIMIZE / RESTORE ===
minBtnWin.MouseButton1Click:Connect(function()
    if not mainWasMoved() then
        miniBtn.Position = main.Position
        main.Visible = false
        miniBtn.Visible = true
    end
end)

miniBtn.MouseButton1Click:Connect(function()
    if not miniWasMoved() then
        main.Position = miniBtn.Position
        miniBtn.Visible = false
        main.Visible = true
    end
end)

-- === CFrame mini-teleport stepper ===
local FIXED_STEP = 1 / 180
local accum = 0

local speedConn = RunService.RenderStepped:Connect(function(dt)
    if not enabled then
        accum = 0
        return
    end

    local char = lp.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    local dir = hum.MoveDirection
    if dir.Magnitude < 0.01 then
        accum = 0
        return
    end

    local bonus = targetSpeed - BASE_SPEED
    if bonus <= 0 then return end

    -- ограничиваем накопленный dt, чтобы не было рывка при просадке FPS
    accum = math.min(accum + dt, 0.05)

    local unit = dir.Unit
    while accum >= FIXED_STEP do
        accum = accum - FIXED_STEP
        hrp.CFrame = hrp.CFrame + unit * (bonus * FIXED_STEP)
    end
end)

-- === СМЕРТЬ → ВЫКЛЮЧАЕМ ВСЁ ===
local charAddedConn, charDiedConn

local function hookCharacter(char)
    if charDiedConn then
        pcall(function() charDiedConn:Disconnect() end)
        charDiedConn = nil
    end
    local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
    if hum then
        charDiedConn = hum.Died:Connect(function()
            disableAll()
        end)
    end
end

if lp.Character then
    task.spawn(hookCharacter, lp.Character)
end

charAddedConn = lp.CharacterAdded:Connect(function(char)
    if bypassActive then
        bypassActive = false
        pcall(deactivateBypass)
        setBypassVisual(false)
    end
    task.spawn(hookCharacter, char)
end)

-- === ПОЛНАЯ ВЫГРУЗКА ===
local function fullUnload()
    disableAll()
    if speedConn then pcall(function() speedConn:Disconnect() end) end
    if charAddedConn then pcall(function() charAddedConn:Disconnect() end) end
    if charDiedConn then pcall(function() charDiedConn:Disconnect() end) end
    if gui and gui.Parent then gui:Destroy() end
    if genv.__SpeedGuiHandle and genv.__SpeedGuiHandle.gui == gui then
        genv.__SpeedGuiHandle = nil
    end
end

closeBtnWin.MouseButton1Click:Connect(fullUnload)

-- === ХЭНДЛ ===
genv.__SpeedGuiHandle = {
    gui = gui,
    unload = fullUnload,
}
